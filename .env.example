# Copy to .env (git-ignored). Local development only.
# SQL Server needs 8+ chars with upper, lower, digit and symbol.
MSSQL_SA_PASSWORD=ChangeMe-Local-2026!

# Claude API key for category suggestions (F9) and the monthly report's findings (F16).
# Optional: leave empty and suggestions are off and the report is written by rules.
ANTHROPIC_API_KEY=

# Claude's read-only MCP endpoint at http://localhost:8000/mcp (F18). Optional: empty = off.
# MCP_TOKEN: any long random string (openssl rand -hex 32). READER_PASSWORD: the read-only
# database login's password (8+ chars with upper, lower, digit and symbol).
MCP_TOKEN=
READER_PASSWORD=

# Interactive Brokers Flex Web Service (F22). Optional: docs/runbooks/ibkr.md.
IBKR_FLEX_TOKEN=
IBKR_FLEX_QUERY_ID=

# For running the API outside Docker (uv run uvicorn app.main:app --reload, from api/):
APP_ENV=local
DATABASE_URL=mssql+pyodbc://sa:ChangeMe-Local-2026!@localhost:1433/cashflow?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
