// Household Cash Flow on Azure always-free tiers.
// Deployed once by infra/azure/bootstrap.sh; GitHub Actions then only rolls new images.

@description('Azure region for all resources.')
param location string = resourceGroup().location

@description('Short prefix for resource names.')
param prefix string = 'cashflow'

@description('Container image. The bootstrap starts with a placeholder; deploy.yml replaces it.')
param image string = 'mcr.microsoft.com/k8se/quickstart:latest'

@description('Port the image listens on (80 for the placeholder, 8000 for the app).')
param targetPort int = 80

@description('SQL administrator login.')
param sqlAdminLogin string = 'cashflowadmin'

@secure()
@description('SQL administrator password (generated by the bootstrap; keep it in your password manager).')
param sqlAdminPassword string

@description('Comma-separated emails allowed to use the app.')
param allowedEmails string

@description('GitHub user that owns the GHCR image.')
param ghcrUsername string

@secure()
@description('GitHub classic token with read:packages, so the Container App can pull the private image.')
param ghcrToken string

@description('Turn on Container Apps sign-in. False on the very first deploy, before the app registration exists.')
param enableAuth bool = false

@description('Client ID of the sign-in app registration (Microsoft personal accounts).')
param authClientId string = ''

@secure()
@description('Client secret of the sign-in app registration.')
param authClientSecret string = ''

@secure()
@description('Claude API key for category suggestions (F9). Empty = suggestions off.')
param anthropicApiKey string = ''

@secure()
@description('Bearer token for Claude\'s read-only MCP endpoint at /mcp (F18). Empty = off.')
param mcpToken string = ''

@secure()
@description('Bearer token the Gmail script posts statements to /api/inbox with (F20). Empty = off.')
param inboxToken string = ''

@secure()
@description('Whose invoice (ADR-036): "Hernan:<cédula>,Lauren:<cédula>". Empty = chosen by hand.')
param invoiceBuyers string = ''

@secure()
@description('Bank sync (ADR-044): the SimpleFIN access URL setup-simplefin.sh claims. Empty = off.')
param simplefinAccessUrl string = ''

@secure()
@description('Password of the read-only database login the MCP endpoint uses (F18).')
param readerPassword string = ''

var suffix = uniqueString(resourceGroup().id)
// Microsoft personal accounts (consumers tenant).
var msaIssuer = '${environment().authentication.loginEndpoint}9188040d-6c67-4c5b-b112-36a304b66dad/v2.0'

// ---------- Azure SQL Database: free offer, auto-pause when the monthly allowance is used ----------
resource sql 'Microsoft.Sql/servers@2023-08-01-preview' = {
  name: '${prefix}-sql-${suffix}'
  location: location
  properties: {
    administratorLogin: sqlAdminLogin
    administratorLoginPassword: sqlAdminPassword
    minimalTlsVersion: '1.2'
    publicNetworkAccess: 'Enabled'
  }
}

resource allowAzure 'Microsoft.Sql/servers/firewallRules@2023-08-01-preview' = {
  parent: sql
  name: 'AllowAzureServices'
  properties: {
    startIpAddress: '0.0.0.0'
    endIpAddress: '0.0.0.0'
  }
}

resource db 'Microsoft.Sql/servers/databases@2023-08-01-preview' = {
  parent: sql
  name: 'cashflow'
  location: location
  sku: {
    name: 'GP_S_Gen5_1'
    tier: 'GeneralPurpose'
    family: 'Gen5'
    capacity: 1 // at most 1 vCore: enough for two people, half the cost when billed
  }
  properties: {
    useFreeLimit: true
    // Keep running past the free allowance (Hernan, Nov 2026): the app must not stop for weeks.
    // cost-guard.bicep emails on the way to $20 and stops the app there (ADR-076).
    freeLimitExhaustionBehavior: 'BillOverUsage'
    autoPauseDelay: 60
    minCapacity: json('0.5')
    maxSizeBytes: 34359738368 // 32 GB
    requestedBackupStorageRedundancy: 'Local'
  }
}

// ---------- Blob storage for statement PDFs and backups ----------
resource storage 'Microsoft.Storage/storageAccounts@2023-05-01' = {
  name: take('${prefix}st${suffix}', 24)
  location: location
  kind: 'StorageV2'
  sku: { name: 'Standard_LRS' }
  properties: {
    allowBlobPublicAccess: false
    minimumTlsVersion: 'TLS1_2'
    supportsHttpsTrafficOnly: true
    allowSharedKeyAccess: false
  }
}

resource blob 'Microsoft.Storage/storageAccounts/blobServices@2023-05-01' = {
  parent: storage
  name: 'default'
}

resource statements 'Microsoft.Storage/storageAccounts/blobServices/containers@2023-05-01' = {
  parent: blob
  name: 'statements'
}

resource backups 'Microsoft.Storage/storageAccounts/blobServices/containers@2023-05-01' = {
  parent: blob
  name: 'backups'
}

// ---------- Container Apps: one app serves API + web, scales to zero ----------
resource env 'Microsoft.App/managedEnvironments@2024-03-01' = {
  name: '${prefix}-env'
  location: location
  properties: {
    workloadProfiles: [
      { name: 'Consumption', workloadProfileType: 'Consumption' }
    ]
  }
}

var databaseUrl = 'mssql+pyodbc://${sqlAdminLogin}:${uriComponent(sqlAdminPassword)}@${sql.properties.fullyQualifiedDomainName}:1433/${db.name}?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no&Connection+Timeout=60'

resource app 'Microsoft.App/containerApps@2024-03-01' = {
  name: '${prefix}-app'
  location: location
  identity: { type: 'SystemAssigned' }
  properties: {
    environmentId: env.id
    workloadProfileName: 'Consumption'
    configuration: {
      activeRevisionsMode: 'Single'
      ingress: {
        external: true
        targetPort: targetPort
        transport: 'auto'
        allowInsecure: false
      }
      registries: [
        { server: 'ghcr.io', username: ghcrUsername, passwordSecretRef: 'ghcr-token' }
      ]
      secrets: concat([
        { name: 'database-url', value: databaseUrl }
        { name: 'ghcr-token', value: ghcrToken }
      ], enableAuth ? [ { name: 'microsoft-provider-secret', value: authClientSecret } ] : [],
        empty(anthropicApiKey) ? [] : [ { name: 'anthropic-api-key', value: anthropicApiKey } ],
        empty(mcpToken) ? [] : [
          { name: 'mcp-token', value: mcpToken }
          { name: 'reader-password', value: readerPassword }
        ],
        empty(inboxToken) ? [] : [ { name: 'inbox-token', value: inboxToken } ],
        empty(invoiceBuyers) ? [] : [ { name: 'invoice-buyers', value: invoiceBuyers } ],
        empty(simplefinAccessUrl) ? [] : [ { name: 'simplefin-access', value: simplefinAccessUrl } ])
    }
    template: {
      containers: [
        {
          name: 'app'
          image: image
          resources: { cpu: json('0.5'), memory: '1Gi' }
          env: concat([
            { name: 'APP_ENV', value: 'azure' }
            { name: 'DATABASE_URL', secretRef: 'database-url' }
            { name: 'ALLOWED_EMAILS', value: allowedEmails }
            { name: 'STORAGE_ACCOUNT_URL', value: storage.properties.primaryEndpoints.blob }
          ], empty(anthropicApiKey) ? [] : [ { name: 'ANTHROPIC_API_KEY', secretRef: 'anthropic-api-key' } ],
            empty(mcpToken) ? [] : [
              { name: 'MCP_TOKEN', secretRef: 'mcp-token' }
              { name: 'READER_PASSWORD', secretRef: 'reader-password' }
            ],
            empty(inboxToken) ? [] : [ { name: 'INBOX_TOKEN', secretRef: 'inbox-token' } ],
            empty(invoiceBuyers) ? [] : [ { name: 'INVOICE_BUYERS', secretRef: 'invoice-buyers' } ],
            empty(simplefinAccessUrl) ? [] : [ { name: 'SIMPLEFIN_ACCESS_URL', secretRef: 'simplefin-access' } ])
        }
      ]
      scale: { minReplicas: 0, maxReplicas: 1 }
    }
  }
}

resource auth 'Microsoft.App/containerApps/authConfigs@2024-03-01' = if (enableAuth) {
  parent: app
  name: 'current'
  properties: {
    platform: { enabled: true }
    globalValidation: {
      unauthenticatedClientAction: 'RedirectToLoginPage'
      redirectToProvider: 'azureactivedirectory'
      // /mcp is Claude's endpoint (F18) and /api/inbox the Gmail script's (F20): each checks its
      // own bearer token instead of a sign-in.
      excludedPaths: [ '/api/health', '/mcp', '/api/inbox', '/api/inbox/transfer' ]
    }
    identityProviders: {
      azureActiveDirectory: {
        enabled: true
        registration: {
          clientId: authClientId
          clientSecretSettingName: 'microsoft-provider-secret'
          openIdIssuer: msaIssuer
        }
      }
    }
  }
}

// The app reads and writes statement PDFs with its managed identity (no storage keys).
resource blobContributor 'Microsoft.Authorization/roleAssignments@2022-04-01' = {
  name: guid(storage.id, app.id, 'blob-contributor')
  scope: storage
  properties: {
    roleDefinitionId: subscriptionResourceId('Microsoft.Authorization/roleDefinitions', 'ba92f5b4-2d11-453d-a403-e96b0029c9fe')
    principalId: app.identity.principalId
    principalType: 'ServicePrincipal'
  }
}

// The budget, its alerts and the kill switch live in cost-guard.bicep (ADR-076).

output appName string = app.name
output fqdn string = app.properties.configuration.ingress.fqdn
output sqlServer string = sql.properties.fullyQualifiedDomainName
output storageAccount string = storage.name
